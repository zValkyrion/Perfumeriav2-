{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "aura",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 3000
    },
    {
      "name": "radar",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "radar", "run", "dev"],
      "port": 3100
    },
    {
      "name": "api-local",
      "runtimeExecutable": "node",
      "runtimeArgs": ["radar/pruebas-locales/servidor-local.mjs"],
      "port": 4700
    },
    {
      "name": "radar-local",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "radar", "run", "dev"],
      "env": { "NEXT_PUBLIC_API": "http://127.0.0.1:4700" },
      "port": 3100
    }
  ]
}
